{
  "expo": {
    "name": "Alert-Drive",
    "slug": "alert-drive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/alert-drive_preto_icone_app_1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "O Alert-Drive reconhece \"estou bem\" no próprio aparelho para você responder sem tocar no celular.",
        "NSMicrophoneUsageDescription": "O Alert-Drive usa o microfone só durante o alerta, para ouvir \"estou bem\". O reconhecimento é feito no aparelho e o áudio não é gravado."
      }
    },
    "android": {
      "package": "com.jnmorais.alertdrive",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/alert-drive_adaptive_foreground_1024.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/alert-drive_preto_arredondado_1024.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/alert-drive_preto_arredondado_1024.png",
          "imageWidth": 150,
          "backgroundColor": "#000000"
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Alert-Drive usa a velocidade do GPS para contar o tempo de direção. A localização não sai do aparelho.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Alert-Drive usa o microfone só durante o alerta, para ouvir \"estou bem\". O reconhecimento é feito no aparelho e o áudio não é gravado.",
          "speechRecognitionPermission": "O Alert-Drive reconhece \"estou bem\" no próprio aparelho para você responder sem tocar no celular."
        }
      ],
      "expo-asset"
    ],
    "scheme": "alert-drive",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dd4d4c81-cbd0-406a-9eb4-db665ff6c665"
      }
    },
    "owner": "jeansmrs"
  }
}
